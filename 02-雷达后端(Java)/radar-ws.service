[Unit]
Description=Radar Java WebSocket service
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/DOMAIN
ExecStart=/usr/bin/java -jar /www/wwwroot/DOMAIN/home-server-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=5
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
